# RStudio files.
^.*\.Rproj$
^\.Rproj\.user$

# Misc.
^TODO.txt$

# Github files. readme.csl is the citation style readme.Rmd renders with;
# it is not needed by the installed package.
^readme\.Rmd$
^readme\.csl$
^\.github$

# Full license text. The License field in DESCRIPTION is the standard
# GPL (>= 2) abbreviation, so R already knows these terms; shipping another
# copy of them in the tarball just draws a CRAN note. Kept in the repository
# so GitHub can detect and display the license.
^LICENSE\.md$

# pkgdown site. The sources are kept in the repository, but the rendered site
# is built by CI and deployed to Netlify rather than shipped in the tarball.
^_pkgdown\.yml$
^docs$
^pkgdown$
